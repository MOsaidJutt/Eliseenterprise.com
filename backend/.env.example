# ── Database (Neon PostgreSQL) ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/neondb?sslmode=require

# ── JWT Secret (generate: python -c "import secrets; print(secrets.token_hex(64))") ──
SECRET_KEY=change-this-to-a-long-random-string-in-production

# ── OpenAI (AI Chat feature — leave blank to disable) ─────────────────────────
OPENAI_API_KEY=sk-...

# ── First admin + company (seeded on first startup if DB is empty) ─────────────
ADMIN_EMAIL=peter@eliseenterprise.com
ADMIN_PASSWORD=Elise@2024!
ADMIN_NAME=Peter
COMPANY_NAME=Plainview
COMPANY_SLUG=plainview
